<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener | Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <% if (locals.user) { %>
        <div class="home-container">
            <div class="header-card">
                <div class="user-info">
                    <span>Welcome, <%= user.name %></span>
                    <span style="opacity: 0.7; font-size: 0.9em;">
                        <%= user.email %>
                    </span>
                </div>
                <div class="header-actions">
                    <button type="button" class="delete-account-btn"
                        onclick="document.getElementById('deleteModal').style.display='flex'">Delete Account</button>
                    <a href="/user/logout" class="logout-btn">Logout</a>
                </div>
            </div>

            <!-- Delete Account Confirmation Modal -->
            <div id="deleteModal" class="modal-overlay" style="display:none;">
                <div class="modal">
                    <h2>⚠️ Delete Account</h2>
                    <p>This action is <strong>permanent</strong>. Your account and all your shortened URLs will be
                        deleted forever.</p>
                    <div class="modal-actions">
                        <button type="button" class="modal-cancel-btn"
                            onclick="document.getElementById('deleteModal').style.display='none'">Cancel</button>
                        <form method="POST" action="/user/delete-account" style="display:inline;">
                            <button type="submit" class="modal-confirm-btn">Confirm Delete</button>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>

                <div class="generator-card">
                    <h1>Shorten Your Link</h1>
                    <form method="post" action="/url" class="url-form">
                        <input type="text" name="url" placeholder="Paste your long URL here (e.g., https://example.com)"
                            required>
                        <button type="submit">Shorten URL</button>
                    </form>
                    <% if (locals.id) { %>
                        <div class="generated-link">
                            <p>Success! Your short ID is <strong><%= id %></strong>. <a href="/<%= id %>"
                                    target="_blank">Click here to test it</a></p>
                        </div>
                        <% } %>
                </div>

                <div class="table-card">
                    <% if (locals.urls && urls.length> 0) { %>
                        <h2>Your Dashboard</h2>
                        <form method="POST" action="/url/delete">
                            <table>
                                <thead>
                                    <tr>
                                        <th>
                                            <input type="checkbox" id="selectAll"> Select
                                        </th>
                                        <th>#</th>
                                        <th>Short ID</th>
                                        <th>Original Link</th>
                                        <th>Clicks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% urls.forEach((url,index)=> { %>
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="shortIds" value="<%= url.shortId %>">
                                            </td>
                                            <td>
                                                <%= index+1 %>
                                            </td>
                                            <td><a href="/<%= url.shortId %>" target="_blank">
                                                    <%= url.shortId %>
                                                </a></td>
                                            <td
                                                style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <a href="<%= url.redirectedURL %>" target="_blank"
                                                    style="color: inherit; text-decoration: none;">
                                                    <%= url.redirectedURL %>
                                                </a>
                                            </td>
                                            <td>
                                                <%= url.visitHistory ? url.visitHistory.length : 0 %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                            <div style="text-align: right;">
                                <button type="submit" class="delete-btn">Delete Selected</button>
                            </div>
                        </form>
                        <% } else if (locals.urls && urls.length===0) { %>
                            <p style="text-align: center; color: #666; margin-top: 1rem;">No links found. Create your
                                first one above!</p>
                            <% } %>
                </div>
        </div>

        <script>
            const selectAll = document.getElementById('selectAll');
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    const checkboxes = document.querySelectorAll('input[name="shortIds"]');
                    for (const checkbox of checkboxes) {
                        checkbox.checked = this.checked;
                    }
                });

                const checkboxes = document.querySelectorAll('input[name="shortIds"]');
                for (const checkbox of checkboxes) {
                    checkbox.addEventListener('change', function () {
                        if (!this.checked) {
                            selectAll.checked = false;
                        } else {
                            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                            selectAll.checked = allChecked;
                        }
                    });
                }
            }
        </script>
</body>

</html>