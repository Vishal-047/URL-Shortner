<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home page</title>
</head>
<body>
    <div style="text-align: center;">
        <h1>URL SHORTNER</h1>
        <form method="post" action="/url">
            <label>Enter the original url: </label>
            <input type="text" name="url" placeholder="https://examples.com">
            <button type="submit">Generate</button>
        </form>
        <% if (locals.id) { %>
                <p>The new generated URL is: http://localhost:8001/<%= id %></p>
        <% } %>
    </div>
    <div>
        <% if (locals.urls) { %>
            <table>
                <thead>
                <th>S.No.</th>
                <th>ShortId</th>
                <th>Redirect</th>
                <th>Clicks</th>
                </thead>
                <tbody>
                    <% urls.forEach((url,index) => { %>
                        <tr>
                     <td><%= index+1 %></td>
                     <td><%= url.shortId %></td>
                     <td><%= url.redirectedURL %></td>
                     <td><%= url.visitHistory.length %></td>
                     </tr>
                     <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
    </body>
</html>